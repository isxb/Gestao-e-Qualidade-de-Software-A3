# ============================================================
# EvoluaPRO — variáveis de ambiente
#
# Copie este arquivo para `.env` na raiz do projeto e preencha com os
# valores reais. NUNCA versione um `.env` com chaves de produção.
# ============================================================

# --------- IA (já existente) ---------
# Chave do Google Generative AI (Gemini). Pode também ser configurada
# pelo painel de admin dentro do app.
GEMINI_API_KEY=your_api_key_here

# --------- Asaas (gateway de pagamento) ---------
# IMPORTANTE: em produção a API key NÃO deve viver no app — qualquer um
# que abrir o APK consegue extrair. O caminho recomendado é subir um
# proxy próprio (Cloud Function / Supabase Edge / sua API) que guarde a
# chave em variável do servidor e exija auth de sessão do cliente.
#
# Modo 1 (proxy próprio — recomendado em produção):
#   defina ASAAS_PROXY_BASE_URL apontando para o seu backend.
#   o app NÃO envia mais o header `access_token`.
ASAAS_PROXY_BASE_URL=

# Modo 2 (Asaas direto — apenas dev/sandbox):
#   se ASAAS_PROXY_BASE_URL estiver vazio, o app fala direto com o
#   Asaas. Use apenas com chave de SANDBOX e nunca em release.
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=

# --------- AdMob ---------
# Em desenvolvimento o app usa IDs de teste oficiais do Google e você
# não precisa preencher nada. Antes do release, registre os ad units
# no console do AdMob e cole os IDs aqui.
#
# Publisher ID (ca-app-pub-XXXXXXXXXXXXXXXX): vai no manifesto Android
# e no Info.plist iOS — ver docs/SETUP.md.
ADMOB_BANNER_ID_ANDROID=
ADMOB_BANNER_ID_IOS=
ADMOB_INTERSTITIAL_ID_ANDROID=
ADMOB_INTERSTITIAL_ID_IOS=

# --------- Google Sign-In ---------
# Em Android e iOS a configuração é via google-services.json /
# GoogleService-Info.plist (NÃO é por aqui).
# Em Web, cole o "Web client ID" abaixo e referencie no web/index.html
# (ver docs/SETUP.md).
GOOGLE_WEB_CLIENT_ID=
